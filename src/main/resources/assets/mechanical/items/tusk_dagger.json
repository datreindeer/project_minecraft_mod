{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:model",
        "model": "mechanical:item/tool_parts/tusk_dagger/head"
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "cases": [
          {
            "when": "stick",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/rod_stick"
            }
          },
          {
            "when": "tool_rod",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/rod_tool_rod"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "mechanical:item/tool_parts/tusk_dagger/rod"
        }
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 1,
        "cases": [
          {
            "when": "twine",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/binding_twine"
            }
          },
          {
            "when": "hide_glue",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/binding_hide_glue"
            }
          },
          {
            "when": "leather",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/binding_leather"
            }
          },
          {
            "when": "sinew",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/tusk_dagger/binding_sinew"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "mechanical:item/tool_parts/tusk_dagger/zone"
        }
      }
    ]
  }
}
