{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:model",
        "model": "mechanical:item/tool_parts/crude_stone_axe/head"
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "cases": [
          {
            "when": "tool_rod",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/crude_stone_axe/rod_tool_rod"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "mechanical:item/tool_parts/crude_stone_axe/rod"
        }
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 1,
        "cases": [
          {
            "when": "cordage",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/crude_stone_axe/binding_cordage"
            }
          },
          {
            "when": "hide_glue",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/crude_stone_axe/binding_hide_glue"
            }
          },
          {
            "when": "leather",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/crude_stone_axe/binding_leather"
            }
          },
          {
            "when": "sinew",
            "model": {
              "type": "minecraft:model",
              "model": "mechanical:item/tool_parts/crude_stone_axe/binding_sinew"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "mechanical:item/tool_parts/crude_stone_axe/zone"
        }
      }
    ]
  }
}
