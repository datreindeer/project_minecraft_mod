{
  "multipart": [
    {
      "when": {
        "stage": "empty"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_empty"
      }
    },
    {
      "when": {
        "stage": "sand"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_sand"
      }
    },
    {
      "when": {
        "stage": "ready"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_ready"
      }
    },
    {
      "when": {
        "stage": "molten"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_molten"
      }
    },
    {
      "when": {
        "stage": "set"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_set"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_chute"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_chute",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_chute",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "mechanical:block/molding_flask_chute",
        "y": 270
      }
    }
  ]
}
