{
  "multipart": [
    {
      "apply": {
        "model": "mechanical:block/clay_channel_middle"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_arm"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_end"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_arm",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_end",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_arm",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_end",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_arm",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "mechanical:block/clay_channel_end",
        "y": 270,
        "uvlock": true
      }
    }
  ]
}
