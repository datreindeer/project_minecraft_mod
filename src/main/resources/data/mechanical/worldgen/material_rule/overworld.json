{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:above_preliminary_surface"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "mechanical:chalk_downs"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:on_floor",
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": {
                          "type": "minecraft:steep"
                        },
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:calcite"
                        }
                      },
                      {
                        "type": "minecraft:condition",
                        "if_true": "minecraft:not_underwater",
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:grass_block"
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:stone_depth",
                    "surface_type": "floor",
                    "offset": 1,
                    "add_surface_depth": false,
                    "secondary_depth_range": 0
                  },
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": {
                          "type": "minecraft:steep"
                        },
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:calcite"
                        }
                      },
                      {
                        "type": "minecraft:block",
                        "result_state": "minecraft:dirt"
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:deep_under_floor",
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:calcite"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:biome",
            "biome_is": "mechanical:limestone_caverns"
          },
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": "minecraft:on_floor",
                "then_run": {
                  "type": "minecraft:block",
                  "result_state": "mechanical:limestone"
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": "minecraft:on_ceiling",
                "then_run": {
                  "type": "minecraft:block",
                  "result_state": "mechanical:limestone"
                }
              },
              {
                "type": "minecraft:block",
                "result_state": "mechanical:limestone"
              }
            ]
          }
        }
      ]
    }
  ]
}
